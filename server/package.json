{
  "name": "load-tracker-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/dev.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "npm run lint && tsc --noEmit && npm test && npm run contrato",
    "contrato": "cmp src/contrato.ts ../mobile/src/api/contrato.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
